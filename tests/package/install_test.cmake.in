# SPDX-License-Identifier: MIT

set(install_prefix "@CMAKE_CURRENT_BINARY_DIR@/install-tree")
set(installed_library
    "${install_prefix}/@CMAKE_INSTALL_LIBDIR@/@CMAKE_STATIC_LIBRARY_PREFIX@exfat_resize@CMAKE_STATIC_LIBRARY_SUFFIX@"
)
set(installed_header "${install_prefix}/@CMAKE_INSTALL_INCLUDEDIR@/exfat_resize.h")
set(installed_cli
    "${install_prefix}/@CMAKE_INSTALL_BINDIR@/exfat-resize@CMAKE_EXECUTABLE_SUFFIX@"
)
set(installed_manpage
    "${install_prefix}/@CMAKE_INSTALL_MANDIR@/man8/exfat-resize.8"
)
set(installed_config
    "${install_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/exfat_resize/exfat_resizeConfig.cmake"
)
set(installed_version_config
    "${install_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/exfat_resize/exfat_resizeConfigVersion.cmake"
)
set(documentation_dir "${install_prefix}/@CMAKE_INSTALL_DOCDIR@")
set(contributing "${documentation_dir}/CONTRIBUTING.md")
set(readme "${documentation_dir}/README.md")
set(license "${documentation_dir}/LICENSE")
set(library_document "${documentation_dir}/docs/LIBRARY.md")
set(partitioning_document "${documentation_dir}/docs/PARTITIONING.md")
set(transaction_document "${documentation_dir}/docs/TRANSACTION.md")
set(development_install_prefix "@CMAKE_CURRENT_BINARY_DIR@/development-install-tree")
set(development_documentation_dir
    "${development_install_prefix}/@CMAKE_INSTALL_DOCDIR@"
)
set(development_library
    "${development_install_prefix}/@CMAKE_INSTALL_LIBDIR@/@CMAKE_STATIC_LIBRARY_PREFIX@exfat_resize@CMAKE_STATIC_LIBRARY_SUFFIX@"
)
set(development_header
    "${development_install_prefix}/@CMAKE_INSTALL_INCLUDEDIR@/exfat_resize.h"
)
set(development_package_dir
    "${development_install_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/exfat_resize"
)

file(REMOVE_RECURSE "${install_prefix}")
set(install_command
    "@CMAKE_COMMAND@" --install "@PROJECT_BINARY_DIR@" --prefix "${install_prefix}"
)
if(DEFINED INSTALL_CONFIG AND NOT INSTALL_CONFIG STREQUAL "")
    list(APPEND install_command --config "${INSTALL_CONFIG}")
endif()
execute_process(
    COMMAND ${install_command}
    RESULT_VARIABLE
        install_result
    OUTPUT_VARIABLE
        install_output
    ERROR_VARIABLE
        install_error
)
if(NOT install_result EQUAL 0)
    message(FATAL_ERROR "Installation failed:\n${install_output}${install_error}")
endif()
foreach(required_file
        "${installed_library}"
        "${installed_header}"
        "${installed_config}"
        "${installed_version_config}"
        "${contributing}"
        "${readme}"
        "${license}"
        "${library_document}"
        "${partitioning_document}"
        "${transaction_document}"
)
    if(NOT EXISTS "${required_file}")
        message(FATAL_ERROR "Installed package file not found at ${required_file}")
    endif()
endforeach()

file(REMOVE_RECURSE "${development_install_prefix}")
set(development_install_command
    "@CMAKE_COMMAND@" --install "@PROJECT_BINARY_DIR@"
    --prefix "${development_install_prefix}"
)
if(DEFINED INSTALL_CONFIG AND NOT INSTALL_CONFIG STREQUAL "")
    list(APPEND development_install_command --config "${INSTALL_CONFIG}")
endif()
list(APPEND development_install_command --component Development)
execute_process(
    COMMAND ${development_install_command}
    RESULT_VARIABLE
        development_install_result
    OUTPUT_VARIABLE
        development_install_output
    ERROR_VARIABLE
        development_install_error
)
if(NOT development_install_result EQUAL 0)
    message(FATAL_ERROR
        "Development-component installation failed:\n"
        "${development_install_output}${development_install_error}"
    )
endif()
foreach(required_file
        "${development_library}"
        "${development_header}"
        "${development_package_dir}/exfat_resizeTargets.cmake"
        "${development_package_dir}/exfat_resizeConfig.cmake"
        "${development_package_dir}/exfat_resizeConfigVersion.cmake"
        "${development_documentation_dir}/CONTRIBUTING.md"
        "${development_documentation_dir}/README.md"
        "${development_documentation_dir}/LICENSE"
        "${development_documentation_dir}/docs/LIBRARY.md"
        "${development_documentation_dir}/docs/PARTITIONING.md"
        "${development_documentation_dir}/docs/TRANSACTION.md"
)
    if(NOT EXISTS "${required_file}")
        message(FATAL_ERROR
            "Development-component package file not found at ${required_file}"
        )
    endif()
endforeach()

if("@EXFAT_RESIZE_BUILD_CLI@")
    if(NOT EXISTS "${installed_cli}")
        message(FATAL_ERROR "Installed CLI file not found at ${installed_cli}")
    endif()
    execute_process(
        COMMAND "${installed_cli}" --version
        RESULT_VARIABLE cli_result
        OUTPUT_VARIABLE cli_output
        ERROR_VARIABLE cli_error
        OUTPUT_STRIP_TRAILING_WHITESPACE
    )
    if(NOT cli_result EQUAL 0 OR
       NOT cli_output STREQUAL "exfat-resize @EXFAT_RESIZE_BUILD_VERSION@")
        message(FATAL_ERROR
            "Installed CLI version check failed:\n${cli_output}${cli_error}"
        )
    endif()
endif()

if("@EXFAT_RESIZE_INSTALL_MANPAGE@")
    if(NOT EXISTS "${installed_manpage}")
        message(FATAL_ERROR "Installed manual page not found at ${installed_manpage}")
    endif()
    file(READ "${installed_manpage}" manpage_contents)
    foreach(required_text
            "exfat-resize @EXFAT_RESIZE_BUILD_VERSION@"
            ".SH SAFETY"
            "RECOVERY AFTER FAILURE"
            "Every normal error exit prints stage-specific recovery guidance"
            "Ctrl-C requests cooperative cancellation"
            "exits with status 130"
            "reports each transaction stage"
            "terminates abnormally without printing stage-specific"
            "restore the verified backup"
            "README.md"
            "docs/TRANSACTION.md"
            "allocator-backed working-memory requirements"
            "Conform to exFAT revision 1.00"
            "Vendor Allocation directory entries"
            "ordinary heap memory"
            "Enlarge a regular image by 2 GiB"
    )
        string(FIND "${manpage_contents}" "${required_text}" required_text_offset)
        if(required_text_offset EQUAL -1)
            message(FATAL_ERROR
                "Installed manual page does not contain: ${required_text}"
            )
        endif()
    endforeach()
endif()

file(READ "${readme}" readme_contents)
foreach(required_text
        "## Safety"
        "Make and verify a backup"
        "run an appropriate exFAT filesystem checker"
        "ensure the check completes successfully"
        "is not a general filesystem checker"
        "Every normal error exit prints stage-specific recovery guidance"
        "Ctrl-C requests cooperative cancellation"
        "exits with status 130"
        "reports each transaction stage"
        "terminates abnormally without printing stage-specific"
        "do not retry the resize"
        "restore the verified backup"
        "## Filesystem compatibility"
        "exfat-resize --grow-partition device size"
        "Conform to exFAT revision 1.00"
        "Vendor Allocation directory entries"
        "docs/PARTITIONING.md"
        "docs/LIBRARY.md"
        "docs/TRANSACTION.md#memory-requirements"
        "exfat_resize(&device, target_size, &allocator, NULL, &stage)"
        "compatible 2.x release"
)
    string(FIND "${readme_contents}" "${required_text}" required_text_offset)
    if(required_text_offset EQUAL -1)
        message(FATAL_ERROR "Installed README does not contain: ${required_text}")
    endif()
endforeach()

file(READ "${library_document}" library_contents)
foreach(required_text
        "# C library reference"
        "## Block-device contract"
        "## Allocator contract"
        "## Operation monitor"
        "EXFAT_RESIZE_CANCELLED"
        "EXFAT_RESIZE_EVENT_CODE_STAGE_ENTERED"
        "EXFAT_RESIZE_EVENT_VALUE_COUNT"
        "unknown event codes"
        "## Results and recovery stages"
        "## Compatibility and migration from 1.x"
        "removes `struct exfat_resize_options`"
        "five-argument declaration"
)
    string(FIND "${library_contents}" "${required_text}" required_text_offset)
    if(required_text_offset EQUAL -1)
        message(FATAL_ERROR
            "Installed library reference does not contain: ${required_text}"
        )
    endif()
endforeach()

string(REGEX MATCHALL "\\[[^]]*\\]\\([^)]+\\)" library_links "${library_contents}")
foreach(library_link IN LISTS library_links)
    string(REGEX REPLACE "^.*\\(([^)]+)\\)$" "\\1" link_target "${library_link}")
    if(link_target MATCHES "^(#|[A-Za-z][A-Za-z0-9+.-]*:|/)")
        continue()
    endif()
    string(REGEX REPLACE "#.*$" "" link_path "${link_target}")
    if(NOT EXISTS "${documentation_dir}/docs/${link_path}")
        message(FATAL_ERROR
            "Installed library-reference link does not resolve: ${link_target}"
        )
    endif()
endforeach()

string(REGEX MATCHALL "\\[[^]]*\\]\\([^)]+\\)" readme_links "${readme_contents}")
foreach(readme_link IN LISTS readme_links)
    string(REGEX REPLACE "^.*\\(([^)]+)\\)$" "\\1" link_target "${readme_link}")
    if(link_target MATCHES "^(#|[A-Za-z][A-Za-z0-9+.-]*:|/)")
        continue()
    endif()
    string(REGEX REPLACE "#.*$" "" link_path "${link_target}")
    if(NOT EXISTS "${documentation_dir}/${link_path}")
        message(FATAL_ERROR
            "Installed README link does not resolve: ${link_target}"
        )
    endif()
endforeach()

file(READ "${partitioning_document}" partitioning_contents)
foreach(required_text
        "# Partition growth outside exfat-resize"
        "focused on growing exFAT filesystems correctly"
        "Apart from that explicit option"
        "## growpart"
        "growpart --dry-run /dev/sdX PARTITION_NUMBER"
        "## GParted Live"
        "resizepart PARTITION_NUMBER NEW_END_SECTOR"
        "## Other architectures"
        "Debian installer rescue mode"
        "Ubuntu Server alternative-architecture images"
        "## Windows DiskPart"
        "Windows DiskPart is not a substitute"
)
    string(FIND "${partitioning_contents}" "${required_text}" required_text_offset)
    if(required_text_offset EQUAL -1)
        message(FATAL_ERROR
            "Installed partitioning document does not contain: ${required_text}"
        )
    endif()
endforeach()

file(READ "${transaction_document}" transaction_contents)
foreach(required_text
        "# Resize transaction"
        "## Transaction sequence"
        "does not promise automatic resume or rollback"
        "before the caller receives a stage"
        "must not retry the resize"
        "requires the verified backup"
        "## Memory requirements"
        "snapshot of the used portion of the source FAT"
        "768 KiB cache block"
        "three 256 KiB"
        "one 32-bit value per target cluster"
)
    string(FIND "${transaction_contents}" "${required_text}" required_text_offset)
    if(required_text_offset EQUAL -1)
        message(FATAL_ERROR
            "Installed transaction document does not contain: ${required_text}"
        )
    endif()
endforeach()

file(READ "${installed_header}" header_contents)
foreach(required_text
        "read the operational safety requirements"
        "complete public-library contract"
        "https://github.com/huven/exfat-resize"
        "docs/LIBRARY.md"
        "docs/TRANSACTION.md"
        "Working-memory sizes and lifetimes"
        "readable and writable"
        "effective-type semantics"
        "storage returned by malloc"
        "9899:2011 section 6.5"
        "borrowed only for that callback invocation"
        "must not be retained"
        "struct exfat_resize_monitor"
        "EXFAT_RESIZE_EVENT_CODE_STAGE_ENTERED"
        "EXFAT_RESIZE_EVENT_VALUE_COUNT"
        "EXFAT_RESIZE_CANCELLED"
)
    string(FIND "${header_contents}" "${required_text}" required_text_offset)
    if(required_text_offset EQUAL -1)
        message(FATAL_ERROR "Installed header does not contain: ${required_text}")
    endif()
endforeach()

execute_process(
    COMMAND "@CMAKE_COMMAND@" -E compare_files "@PROJECT_SOURCE_DIR@/LICENSE" "${license}"
    RESULT_VARIABLE license_comparison
)
if(NOT license_comparison EQUAL 0)
    message(FATAL_ERROR "Installed LICENSE differs from the repository LICENSE")
endif()
